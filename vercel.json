{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://influencer-backend.vercel.app/api/sitemap.xml" },
    { "source": "/search.md", "destination": "https://influencer-backend.vercel.app/api/md/talent" },
    { "source": "/browse.md", "destination": "https://influencer-backend.vercel.app/api/md/talent" },
    { "source": "/campaigns.md", "destination": "https://influencer-backend.vercel.app/api/md/campaigns" },
    {
      "source": "/people/:slug([^/.]+).md",
      "destination": "https://influencer-backend.vercel.app/api/md/people/:slug"
    },
    {
      "source": "/campaigns/:id([^/.]+).md",
      "destination": "https://influencer-backend.vercel.app/api/md/campaigns/:id"
    },
    { "source": "/api/:path*", "destination": "https://influencer-backend.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/(index|about).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\"" }
      ]
    },
    {
      "source": "/about",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</about.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    }
  ]
}
